---
// src/pages/contacto.astro
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <header class="mb-12 text-center">
        <h2 class="text-3xl font-bold text-pink-800 mb-4">
          Contáctanos
        </h2>
        <p class="text-lg text-gray-600">
          ¿Tienes preguntas? Estamos aquí para ayudarte.
        </p>
      </header>

      <div class="grid gap-10 md:grid-cols-2">
        <!-- Información de contacto -->
        <div class="space-y-6">
          <h3 class="text-2xl font-bold text-pink-800 mb-4">
            Información de contacto
          </h3>

          <div class="space-y-4">
            <div class="flex items-start">
              <span class="text-pink-600 flex-shrink-0">📍</span>
              <div class="ml-3">
                <p class="font-medium">Dirección</p>
                <p class="text-gray-600">Calle de la Belleza 123, Ciudad de la Color</p>
              </div>
            </div>

            <div class="flex items-start">
              <span class="text-pink-600 flex-shrink-0">📞</span>
              <div class="ml-3">
                <p class="font-medium">Teléfono</p>
                <p class="text-gray-600">+56 9 1234 5678</p>
              </div>
            </div>

            <div class="flex items-start">
              <span class="text-pink-600 flex-shrink-0">📧</span>
              <div class="ml-3">
                <p class="font-medium">Correo</p>
                <p class="text-gray-600">hello@nailsbynatalia.cl</p>
              </div>
            </div>

            <div class="flex items-start">
              <span class="text-pink-600 flex-shrink-0">🕒</span>
              <div class="ml-3">
                <p class="font-medium">Horarios</p>
                <p class="text-gray-600">Lunes-Viernes 9:00-19:00, Sábados 10:00-17:00</p>
              </div>
            </div>

            <div class="flex items-start">
              <span class="text-pink-600 flex-shrink-0" aria-label="WhatsApp">💬</span>
              <div class="ml-3">
                <p class="font-medium">WhatsApp</p>
                <p class="text-gray-600">+56 9 1234 5678</p>
              </div>
            </div>

            <div class="flex items-start">
              <span class="text-pink-600 flex-shrink-0" aria-label="Instagram">📷</span>
              <div class="ml-3">
                <p class="font-medium">Instagram</p>
                <p class="text-gray-600">@nailsbynatalia</p>
              </div>
            </div>

            <div class="flex items-start">
              <span class="text-pink-600 flex-shrink-0" aria-label="TikTok">🎵</span>
              <div class="ml-3">
                <p class="font-medium">TikTok</p>
                <p class="text-gray-600">@nailsbynatalia</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Formulario de contacto -->
        <div>
          <form class="bg-white rounded-lg shadow-md p-6 space-y-5">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="contact-name" class="block text-sm font-medium text-gray-700 mb-2">
                  Nombre
                </label>
                <input type="text" id="contact-name" placeholder="Tu nombre" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-pink-500 focus:border-pink-500" required>
              </div>

              <div>
                <label for="contact-email" class="block text-sm font-medium text-gray-700 mb-2">
                  Correo electrónico
                </label>
                <input type="email" id="contact-email" placeholder="tu@email.com" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-pink-500 focus:border-pink-500" required>
              </div>
            </div>

            <div>
              <label for="contact-subject" class="block text-sm font-medium text-gray-700 mb-2">
                Asunto
              </label>
              <input type="text" id="contact-subject" placeholder="Asunto de tu mensaje" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-pink-500 focus:border-pink-500" required>
            </div>

            <div>
              <label for="contact-message" class="block text-sm font-medium text-gray-700 mb-2">
                Mensaje
              </label>
              <textarea id="contact-message" rows="5" placeholder="Escribe tu mensaje aquí..." class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-pink-500 focus:border-pink-500" required></textarea>
            </div>

            <div class="text-center">
              <button type="submit" class="bg-pink-600 hover:bg-pink-700 text-white font-bold py-3 px-8 rounded-lg transition-colors transform hover:scale-105 w-full">
                Enviar mensaje
              </button>
            </div>
          </form>

          <div class="mt-6 p-4 bg-pink-50 rounded-lg text-center">
            <p class="text-pink-800 font-medium">
              ¡Tu mensaje ha sido enviado! Nos pondremos en contacto contigo pronto.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>