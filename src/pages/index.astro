---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="page-shell">
    <div class="bg-glow glow-1" aria-hidden="true"></div>
    <div class="bg-glow glow-2" aria-hidden="true"></div>
    <div class="bg-glow glow-3" aria-hidden="true"></div>

    <aside class="nav-rail" aria-label="Navegación principal">
      <div class="nav-brand" aria-label="Nails by Natalia">✦</div>
      <nav class="nav-list">
        <a
          href="#inicio"
          class="nav-link active"
          aria-label="Inicio"
          aria-current="true">⌂</a
        >
        <a href="#servicios" class="nav-link" aria-label="Servicios">✂</a>
        <a href="#galeria" class="nav-link" aria-label="Galería">▣</a>
        <a href="#precios" class="nav-link" aria-label="Precios">◌</a>
        <a href="#sobre-mi" class="nav-link" aria-label="Sobre Natalia">♥</a>
        <a href="#contacto" class="nav-link" aria-label="Contacto">✆</a>
      </nav>
    </aside>

    <section class="hero glass-panel" id="inicio">
      <div class="hero-backdrop" aria-hidden="true"></div>
      <div class="hero-content">
        <span class="eyebrow">Estudio de uñas por Natalia</span>
        <h1>
          Uñas hermosas,<br />
          <span>tú con confianza</span>
        </h1>
        <p>
          Experiencia de belleza con cuidado experto, diseños únicos y una
          atención cálida que realza tu estilo en cada detalle.
        </p>
        <div class="cta-row">
          <a href="#contacto" class="btn btn-primary">♡ Reservar cita</a>
          <a href="#galeria" class="btn btn-secondary">Ver galería</a>
        </div>
        <div class="stats-row">
          <div class="stat">
            <strong>1000+</strong>
            <span>Clientes felices</span>
          </div>
          <div class="stat">
            <strong>98%</strong>
            <span>Satisfacción</span>
          </div>
          <div class="stat">
            <strong>50+</strong>
            <span>Estilos nuevos</span>
          </div>
          <div class="stat">
            <strong>5+</strong>
            <span>Años de experiencia</span>
          </div>
        </div>
      </div>
    </section>

    <section class="services glass-panel" id="servicios">
      <div class="section-heading">
        <span class="eyebrow">Nuestros servicios</span>
        <h2>Cuidados <span>expertos</span></h2>
      </div>

      <div class="service-spotlight">
        <div class="service-cards">
          <div class="mini-badge badge-one">
            <span>✦</span>
            <div>
              <strong>Cuidado experto</strong>
              <small>Precisión y estilo</small>
            </div>
          </div>
          <div class="mini-badge badge-three">
            <span>✧</span>
            <div>
              <strong>Calidad premium</strong>
              <small>Acabados duraderos</small>
            </div>
          </div>
        </div>

        <div class="service-image"></div>
        <div class="service-info">
          <div class="service-tag">Higiene</div>
          <div class="service-tag soft">Premium</div>
          <h3>Manicura gel lujo</h3>
          <p>
            Acabados impecables, uñas cuidadas y diseños con un toque
            sofisticado y personalizado.
          </p>
          <ul>
            <li>Diseños a medida</li>
            <li>Forma y cuidado profesional</li>
            <li>Durabilidad y brillo</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="gallery-section" id="galeria">
      <div class="section-heading center">
        <span class="eyebrow">Nuestra galería</span>
        <h2>Diseños <span>inolvidables</span></h2>
      </div>

      <div class="gallery-grid">
        <article class="gallery-item item-1"><span>Minimal</span></article>
        <article class="gallery-item item-2"><span>Elegante</span></article>
        <article class="gallery-item item-3"><span>Bold</span></article>
        <article class="gallery-item item-4"><span>Arte</span></article>
        <article class="gallery-item item-5"><span>Soft</span></article>
        <article class="gallery-item item-6"><span>Brillo</span></article>
        <article class="gallery-item item-7"><span>Femenino</span></article>
        <article class="gallery-item item-8"><span>Premium</span></article>
      </div>
    </section>

    <section class="about glass-panel" id="sobre-mi">
      <div class="about-image-wrap">
        <div class="about-image"></div>
        <div class="floating-badge">
          <strong>2018</strong>
          <span>Desde</span>
        </div>
      </div>

      <div class="about-copy">
        <span class="eyebrow">Mi historia</span>
        <h2>Creando belleza <span>sin prisas</span></h2>
        <p>
          Natalia combina técnica, creatividad y detalle para crear manicuras
          que realzan la personalidad de cada cliente y elevan cada momento
          especial.
        </p>
        <p>
          Cada diseño se piensa con precisión, cuidando la forma, la salud de la
          uña y el estilo de la persona para lograr resultados naturales y
          sofisticados.
        </p>

        <div class="feature-grid">
          <div class="feature-item">
            <span>✦</span>
            <div>
              <strong>Higiene</strong>
              <small>100% profesional</small>
            </div>
          </div>
          <div class="feature-item">
            <span>✧</span>
            <div>
              <strong>Calidad</strong>
              <small>Productos premium</small>
            </div>
          </div>
          <div class="feature-item">
            <span>✹</span>
            <div>
              <strong>Estilo</strong>
              <small>Personalizado</small>
            </div>
          </div>
          <div class="feature-item">
            <span>♡</span>
            <div>
              <strong>Atención</strong>
              <small>Cercana y amable</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pricing glass-panel" id="precios">
      <div class="section-heading center">
        <span class="eyebrow">Precios</span>
        <h2>Lujo <span>accesible</span></h2>
      </div>

      <div class="pricing-grid">
        <article class="price-card">
          <span class="plan-name">Cuidado básico</span>
          <div class="price-line">
            <strong>$25</strong><small>/ sesión</small>
          </div>
          <ul>
            <li>Forma y limado</li>
            <li>Cuidado de cutículas</li>
            <li>Brillo extra</li>
          </ul>
          <button type="button">Seleccionar</button>
        </article>

        <article class="price-card featured">
          <span class="plan-name">Premiun glam</span>
          <div class="price-line">
            <strong>$45</strong><small>/ sesión</small>
          </div>
          <ul>
            <li>Gel de alta duración</li>
            <li>Diseño a medida</li>
            <li>Finalización premium</li>
          </ul>
          <button type="button" class="featured-btn">Elegir plan</button>
        </article>

        <article class="price-card">
          <span class="plan-name">Spa de lujo</span>
          <div class="price-line">
            <strong>$75</strong><small>/ sesión</small>
          </div>
          <ul>
            <li>Tratamiento relajante</li>
            <li>Arte y diseño exclusivo</li>
            <li>Detalle final premium</li>
          </ul>
          <button type="button">Seleccionar</button>
        </article>
      </div>
      <p class="pricing-note">Diseños complejos se cotizan por separado.</p>
    </section>

    <section class="booking" id="contacto">
      <div class="booking-form glass-panel">
        <div class="section-heading left">
          <span class="eyebrow">Reserva</span>
          <h2>Reserva tu cita</h2>
        </div>

        <form>
          <div class="input-row">
            <label>
              Nombre completo
              <input type="text" placeholder="Tu nombre" />
            </label>
            <label>
              Correo electrónico
              <input type="email" placeholder="tucorreo@email.com" />
            </label>
          </div>
          <div class="input-row">
            <label>
              Teléfono
              <input type="tel" placeholder="+34 600 000 000" />
            </label>
            <label>
              Servicio
              <select>
                <option>Manicura gel</option>
                <option>Diseño premium</option>
                <option>Spa de lujo</option>
                <option>Consulta personalizada</option>
              </select>
            </label>
          </div>
          <label>
            Mensaje
            <textarea rows="4" placeholder="Cuéntanos qué te gustaría..."
            ></textarea>
          </label>
          <button type="button" class="btn btn-primary submit-btn"
            >Enviar solicitud</button
          >
        </form>
      </div>

      <div class="booking-photo-wrap glass-panel">
        <div class="booking-photo"></div>
      </div>
    </section>

    <footer class="site-footer glass-panel">
      <div>
        <strong>Nails by Natalia</strong>
        <p>Calle Mayor 24</p>
      </div>
      <div>
        <strong>Horario</strong>
        <p>Lun - Sáb: 10:00 - 20:00</p>
      </div>
      <div class="social-block">
        <strong>Contacto</strong>
        <div class="social-links">
          <a
            href="https://wa.me/34600000000"
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12.04 2a9.9 9.9 0 0 0-8.4 15.16L2 22l4.98-1.6A9.9 9.9 0 1 0 12.04 2Zm0 18.02a8.1 8.1 0 0 1-4.12-1.13l-.3-.18-3.06.98 1-2.98-.19-.31a8.12 8.12 0 1 1 6.67 3.62Zm4.44-6.08c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06a6.63 6.63 0 0 1-3.3-2.88c-.14-.24 0-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.43-.58 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
              />
            </svg>
          </a>
          <a
            href="https://instagram.com/nailsbynatalia"
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.8c-3.15 0-3.5.01-4.74.07-1.15.05-1.77.24-2.18.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.18-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05 1.15.24 1.77.4 2.18.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.18.4 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c1.15-.05 1.77-.24 2.18-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.35-1.03.4-2.18.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-1.15-.24-1.77-.4-2.18a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.18-.4-1.24-.06-1.59-.07-4.74-.07Zm0 3.06a4.98 4.98 0 1 1 0 9.96 4.98 4.98 0 0 1 0-9.96Zm0 1.8a3.18 3.18 0 1 0 0 6.36 3.18 3.18 0 0 0 0-6.36Zm5.18-1.98a1.16 1.16 0 1 1 0 2.32 1.16 1.16 0 0 1 0-2.32Z"
              />
            </svg>
          </a>
          <a
            href="https://tiktok.com/@nailsbynatalia"
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M16.6 2h-3.2v13.1a2.6 2.6 0 1 1-2.6-2.6c.27 0 .53.04.78.12V9.34a5.9 5.9 0 0 0-.78-.05 5.8 5.8 0 1 0 5.8 5.8V8.5a7.2 7.2 0 0 0 4.2 1.35V6.63a4.05 4.05 0 0 1-4.2-3.9V2Z"
              />
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <nav class="mobile-dock" aria-label="Navegación móvil">
      <a href="#inicio" class="mobile-link active" aria-label="Inicio">⌂</a>
      <a href="#servicios" class="mobile-link" aria-label="Servicios">✂</a>
      <a href="#galeria" class="mobile-link" aria-label="Galería">▣</a>
      <a href="#precios" class="mobile-link" aria-label="Precios">◌</a>
      <a href="#contacto" class="mobile-link" aria-label="Contacto">♥</a>
    </nav>
  </main>

  <style>
    :global(body) {
      background:
        radial-gradient(
          circle at top,
          rgba(255, 117, 186, 0.2),
          transparent 28%
        ),
        linear-gradient(180deg, #2e0819 0%, #450b28 42%, #220914 100%);
    }

    .page-shell {
      position: relative;
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem 1rem 6rem;
      overflow: hidden;
    }

    .bg-glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(85px);
      pointer-events: none;
      opacity: 0.48;
      animation: drift 18s ease-in-out infinite alternate;
    }

    .glow-1 {
      width: 320px;
      height: 320px;
      left: 7%;
      top: 0;
      background: rgba(255, 109, 180, 0.35);
    }

    .glow-2 {
      width: 380px;
      height: 380px;
      right: 7%;
      top: 22%;
      background: rgba(151, 58, 91, 0.38);
      animation-delay: 1s;
    }

    .glow-3 {
      width: 260px;
      height: 260px;
      left: 34%;
      bottom: 18%;
      background: rgba(255, 171, 208, 0.18);
    }

    .glass-panel {
      position: relative;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 30px;
      backdrop-filter: blur(15px);
      box-shadow: 0 20px 40px rgba(16, 3, 10, 0.28);
    }

    .nav-rail {
      position: fixed;
      left: 1.4rem;
      top: 50%;
      transform: translateY(-50%);
      z-index: 30;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.8rem;
      padding: 0.8rem 0.5rem;
      background: rgba(35, 11, 23, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 2rem;
      box-shadow: 0 18px 30px rgba(0, 0, 0, 0.2);
    }

    .nav-brand {
      display: grid;
      place-items: center;
      width: 2.7rem;
      height: 2.7rem;
      border-radius: 16px;
      background: linear-gradient(
        135deg,
        rgba(255, 115, 180, 0.8),
        rgba(214, 66, 130, 0.6)
      );
      color: white;
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.35rem;
    }

    .nav-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .nav-link {
      position: relative;
      display: grid;
      place-items: center;
      width: 2.8rem;
      height: 2.8rem;
      border-radius: 14px;
      text-decoration: none;
      color: rgba(255, 255, 255, 0.78);
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid transparent;
      transition:
        transform 0.25s ease,
        background 0.25s ease,
        border-color 0.25s ease;
    }

    .nav-link:hover,
    .nav-link.active {
      background: linear-gradient(
        135deg,
        rgba(246, 88, 157, 0.3),
        rgba(255, 121, 188, 0.14)
      );
      border-color: rgba(255, 216, 233, 0.25);
      transform: translateX(2px);
    }

    .hero {
      position: relative;
      padding: 3rem 2rem 1.5rem;
      margin-top: 0.5rem;
      min-height: 560px;
      overflow: hidden;
      background: linear-gradient(
        180deg,
        rgba(93, 19, 43, 0.85),
        rgba(62, 17, 32, 0.65)
      );
    }

    .hero-backdrop {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(25, 8, 18, 0.55), rgba(25, 8, 18, 0.15)),
        url("https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?auto=format&fit=crop&w=1200&q=80")
          center/cover no-repeat;
      filter: saturate(1.1);
      opacity: 0.75;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 520px;
      padding-top: 2.8rem;
      margin-left: 1.25rem;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: rgba(255, 241, 247, 0.9);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      backdrop-filter: blur(8px);
    }

    .hero h1 {
      margin: 1rem 0 0.8rem;
      font-size: clamp(3rem, 4vw, 5rem);
      line-height: 0.9;
      letter-spacing: -0.06em;
      color: #fff;
      font-weight: 700;
    }

    .hero h1 span {
      display: inline-block;
      background: linear-gradient(90deg, #fff 0%, #ff9ec6 40%, #ff5ca9 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      font-style: italic;
    }

    .hero p {
      max-width: 430px;
      color: rgba(255, 239, 245, 0.82);
      font-size: 1rem;
      line-height: 1.6;
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
      margin-top: 1.3rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      text-decoration: none;
      border: none;
      cursor: pointer;
      border-radius: 999px;
      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
      padding: 0.9rem 1.5rem;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      background: linear-gradient(135deg, #ff4fa4, #d93d7d);
      color: white;
      box-shadow: 0 18px 33px rgba(255, 92, 175, 0.45);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.06);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.8rem;
      margin-top: 2rem;
      max-width: 560px;
    }

    .stat {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      padding: 0.7rem 0.5rem;
      text-align: center;
    }

    .stat strong {
      display: block;
      font-size: 1.4rem;
      letter-spacing: -0.05em;
    }

    .stat span {
      display: block;
      margin-top: 0.2rem;
      font-size: 0.68rem;
      color: rgba(255, 235, 242, 0.8);
    }

    .services,
    .about,
    .pricing,
    .booking-form,
    .site-footer {
      margin-top: 1.6rem;
      padding: 1.5rem 1.1rem;
    }

    .section-heading {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .section-heading.center {
      align-items: center;
      text-align: center;
    }

    .section-heading.left {
      margin-bottom: 1.2rem;
    }

    .section-heading h2 {
      margin: 0;
      font-size: clamp(2.25rem, 3vw, 3.2rem);
      letter-spacing: -0.05em;
    }

    .section-heading h2 span {
      display: inline-block;
      background: linear-gradient(90deg, #fff 0%, #ffcfe2 35%, #ff78b8 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      font-style: italic;
    }

    .service-spotlight {
      position: relative;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 1.2rem;
      min-height: 360px;
      padding: 0.4rem 0.2rem 0.2rem;
    }

    .service-cards {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .mini-badge {
      position: absolute;
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.7rem 0.8rem;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      backdrop-filter: blur(8px);
      color: white;
      box-shadow: 0 14px 26px rgba(0, 0, 0, 0.18);
    }

    .mini-badge strong,
